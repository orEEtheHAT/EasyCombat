.studio { background-color: rgb(22, 27, 35); color: rgb(225, 231, 241); flex-grow: 1; }
.row { flex-direction: row; }
.grow { flex-grow: 1; min-width: 0; min-height: 0; }
.header { padding: 22px 24px 18px 24px; align-items: center; border-bottom-width: 1px; border-bottom-color: rgb(51, 62, 75); }
.brand { flex-grow: 1; }
.eyebrow { font-size: 10px; -unity-font-style: bold; color: rgb(99, 212, 195); margin-bottom: 7px; }
.brand-title { font-size: 28px; -unity-font-style: bold; margin-bottom: 4px; }
.muted { font-size: 11px; color: rgb(157, 171, 190); }
.wrap { white-space: normal; }
.tabs { margin-left: 15px; }
.studio Button { background-color: rgb(42, 51, 65); color: rgb(218, 228, 240); border-width: 1px; border-color: rgb(62, 75, 93); border-radius: 5px; padding: 7px 12px; margin: 2px 5px 2px 0; }
.studio Button:hover { background-color: rgb(56, 72, 87); border-color: rgb(109, 172, 175); }
.studio Button:focus { border-color: rgb(98, 218, 194); }
.studio Button.primary { background-color: rgb(63, 194, 171); color: rgb(15, 39, 40); border-color: rgb(63, 194, 171); -unity-font-style: bold; }
.studio Button.primary:hover { background-color: rgb(100, 221, 195); }
.studio Button.tab { background-color: rgba(0,0,0,0); border-color: rgba(0,0,0,0); padding: 9px 13px; }
.studio Button.tab.active { background-color: rgb(40, 67, 69); color: rgb(129, 237, 214); border-color: rgb(54, 96, 95); }
.toolbar { padding: 9px 24px; background-color: rgb(27, 33, 43); }
.notice { padding: 7px 24px; font-size: 11px; color: rgb(155, 174, 193); background-color: rgb(24, 30, 39); white-space: normal; }
.notice.error { color: rgb(255, 169, 140); }
.body { overflow: hidden; }
.navigation { width: 178px; min-width: 178px; padding: 21px 10px; border-right-width: 1px; border-right-color: rgb(50, 59, 72); }
.navigation > .eyebrow { margin-left: 9px; }
.studio Button.category { background-color: rgba(0,0,0,0); border-color: rgba(0,0,0,0); -unity-text-align: middle-left; padding: 10px 8px; margin: 2px 0; }
.studio Button.category.selected { color: rgb(137, 239, 215); background-color: rgb(36, 62, 65); border-color: rgb(49, 91, 88); }
.sidebar-note { color: rgb(123, 147, 165); font-size: 11px; white-space: normal; margin: 12px 8px; }
.browser { width: 246px; min-width: 225px; border-right-width: 1px; border-right-color: rgb(50, 59, 72); background-color: rgb(26, 32, 42); }
.browser-top { padding: 20px 14px 12px 14px; }
.browser-top ToolbarSearchField { margin-bottom: 9px; width: auto; }
.asset-row { padding: 11px 12px; margin: 4px 9px; border-left-width: 3px; border-radius: 4px; background-color: rgb(34, 42, 54); }
.asset-title { -unity-font-style: bold; font-size: 12px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.asset-meta { font-size: 10px; color: rgb(143, 161, 182); margin-top: 4px; }
.unity-collection-view__item--selected .asset-row { background-color: rgb(44, 68, 78); }
.detail { padding: 0 6px 0 0; }
.detail-header { padding: 22px 22px 8px 22px; }
.detail-title { font-size: 25px; -unity-font-style: bold; white-space: normal; }
.path { margin-top: 5px; color: rgb(127, 146, 169); font-size: 10px; white-space: normal; }
.actions { margin-top: 12px; flex-wrap: wrap; }
.summary { padding: 6px 22px; }
.metrics { margin-bottom: 8px; }
.metric { background-color: rgb(31, 42, 53); border-radius: 6px; padding: 12px; margin-right: 7px; flex-basis: 0; }
.metric-value { font-size: 19px; -unity-font-style: bold; white-space: normal; }
.warning { padding: 9px; margin-top: 7px; background-color: rgb(66, 49, 36); color: rgb(245, 195, 127); border-radius: 4px; }
.links { padding: 10px 22px 0 22px; }
.dependency-row { padding: 5px 0; }
.chips { flex-wrap: wrap; }
.studio Button.chip { padding: 4px 8px; font-size: 11px; color: rgb(155, 222, 214); background-color: rgb(31, 51, 59); }
.section-title { color: rgb(136, 157, 178); font-size: 10px; -unity-font-style: bold; margin: 18px 22px 9px 22px; }
.inspector { background-color: rgb(45, 48, 54); padding: 14px; margin: 0 16px 20px 22px; border-radius: 6px; color: rgb(220, 225, 233); }
.empty { padding: 30px; white-space: normal; }
.page { flex-grow: 1; padding: 24px; }
.page-title { font-size: 26px; -unity-font-style: bold; white-space: normal; }
.lead { font-size: 13px; color: rgb(169, 189, 206); margin-top: 8px; margin-bottom: 21px; white-space: normal; }
.flow { margin-bottom: 14px; }
.guide-card { background-color: rgb(31, 41, 53); border-width: 1px; border-color: rgb(47, 62, 78); border-radius: 7px; padding: 16px; margin-right: 10px; flex-basis: 0; }
.card-title { font-size: 16px; -unity-font-style: bold; margin-bottom: 9px; white-space: normal; }
.guide-text { color: rgb(181, 196, 211); font-size: 12px; white-space: normal; margin-bottom: 9px; }
.recipe { margin-bottom: 16px; flex-basis: auto; }
.guide-link { align-self: flex-start; margin-top: 8px; }
.result-row { border-bottom-width: 1px; border-bottom-color: rgb(55, 72, 90); padding: 9px 0; }
.result-cell { flex-basis: 0; }
.log-row { white-space: normal; background-color: rgb(31, 41, 53); margin: 3px 0; padding: 10px; border-radius: 5px; color: rgb(209, 224, 236); overflow: hidden; }
