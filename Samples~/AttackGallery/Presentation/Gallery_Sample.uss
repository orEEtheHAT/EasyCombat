.gallery {
    position: absolute; left: 14px; top: 14px; width: 350px; max-width: 94%; max-height: 94%;
    padding: 12px; background-color: rgba(14, 29, 37, 0.97); color: rgb(235, 243, 242);
    border-left-width: 3px; border-left-color: rgb(90, 216, 191);
}
.title { font-size: 23px; -unity-font-style: bold; color: rgb(235, 248, 244); margin-bottom: 8px; }
.choices, .actions { flex-direction: row; flex-wrap: wrap; }
.gallery Button {
    background-color: rgb(40, 63, 72); color: white; border-width: 0; margin: 2px;
    padding: 5px 7px; min-height: 28px; border-radius: 3px;
}
.choices .choice { width: 48%; -unity-text-align: middle-left; }
.gallery Button:hover { background-color: rgb(59, 87, 93); }
.choices .selected, .actions .fire { background-color: rgb(30, 108, 96); -unity-font-style: bold; }
.description { white-space: normal; color: rgb(204, 222, 226); min-height: 52px; margin: 9px 2px 4px 2px; }
.actions Button { flex-grow: 1; }
.readout { color: rgb(224, 237, 235); white-space: normal; margin: 12px 2px 0 2px; }
