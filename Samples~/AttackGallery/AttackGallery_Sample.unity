MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 779725821}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: edadebe67be75554681e2aae9186c9e4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: EasyCombat.Samples.AttackGallery::EasyCombat.Samples.AttackGallery
  Examples:
  - Recipe: {fileID: 11400000, guid: e0aa7d342b4ef264fb39bed2cfe8a2ba, type: 2}
    Title: Sword slash
    Description: Sweep the blade through the front dummy. The middle of the swing
      can hit each target once.
    Tint: {r: 1, g: 0.78, b: 0.24, a: 1}
  - Recipe: {fileID: 11400000, guid: e98b2c9e2d1fabc4495e76600ecb7ca6, type: 2}
    Title: Pistol shot
    Description: An instant, narrow hit. The first dummy stops the shot.
    Tint: {r: 0.47, g: 0.85, b: 0.79, a: 1}
  - Recipe: {fileID: 11400000, guid: 8e7ca3393b4757248869c23ef2d3a665, type: 2}
    Title: Rail shot
    Description: A wide instant shot pierces up to three dummies in the lane.
    Tint: {r: 0, g: 1, b: 1, a: 1}
  - Recipe: {fileID: 11400000, guid: 8ed54d28070f3114e9eaf14ec3ca663e, type: 2}
    Title: Poison dart
    Description: Repeated darts add independent poison stacks. Each stack deals damage
      on its own timer.
    Tint: {r: 0.59, g: 0.94, b: 0.18, a: 1}
  - Recipe: {fileID: 11400000, guid: 0621003d10d22d84db58979657824c70, type: 2}
    Title: Fireball
    Description: The impact explodes and leaves burning ground. Each field pulse
      deals fire damage and refreshes Burn.
    Tint: {r: 1, g: 0.35, b: 0.06, a: 1}
  - Recipe: {fileID: 11400000, guid: f2dade0a58578ec498bfb8f4a15eb563, type: 2}
    Title: Frost cone
    Description: Dummies inside the cone lose half their movement speed for three
      seconds. Their HP stays the same.
    Tint: {r: 0, g: 1, b: 1, a: 1}
  - Recipe: {fileID: 11400000, guid: ab2cc43933b32bc4ea5db37b6572d6ec, type: 2}
    Title: Shock nova
    Description: A pulse around the launcher. Close dummies take more damage than
      dummies near the edge.
    Tint: {r: 0.48, g: 0.54, b: 1, a: 1}
  - Recipe: {fileID: 11400000, guid: f28606656758fb2459823dbb6049c28c, type: 2}
    Title: Chain orb
    Description: The orb jumps to two nearby unvisited dummies. Each jump retains
      70% of the previous hit.
    Tint: {r: 0.48, g: 0.54, b: 1, a: 1}
  - Recipe: {fileID: 11400000, guid: 2d30e2d985da6eb4a9d472a5462e1084, type: 2}
    Title: Plasma beam
    Description: A sustained wide beam pulses through the lane every 0.2 seconds.
    Tint: {r: 0.3, g: 1, b: 0.88, a: 1}
  - Recipe: {fileID: 11400000, guid: e8720a08848781e4baaac43bd03a3077, type: 2}
    Title: Siege bolt
    Description: A slow projectile deals 6 damage plus 8% of the target's maximum
      HP. The percentage part is capped at 30.
    Tint: {r: 1, g: 0.78, b: 0.24, a: 1}
